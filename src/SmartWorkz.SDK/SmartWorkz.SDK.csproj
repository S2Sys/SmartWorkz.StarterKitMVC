<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SmartWorkz.SDK</AssemblyName>
    <RootNamespace>SmartWorkz</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet Package Information -->
    <PackageId>SmartWorkz.SDK</PackageId>
    <Version>1.0.0</Version>
    <Title>SmartWorkz API SDK</Title>
    <Authors>S2 Systems</Authors>
    <Description>Official C# SDK for SmartWorkz APIs. Provides strongly-typed clients for authentication, users, transactions, products, reports, and webhooks with full async/await support.</Description>
    <PackageProjectUrl>https://github.com/S2Sys/SmartWorkz</PackageProjectUrl>
    <RepositoryUrl>https://github.com/S2Sys/SmartWorkz</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>smartworkz;api;sdk;rest;http;client;async</PackageTags>
    <PackageReleaseNotes>Initial release with support for authentication, users, transactions, products, reports, and webhooks APIs.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Sample/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Net.Http.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
  </ItemGroup>
</Project>

