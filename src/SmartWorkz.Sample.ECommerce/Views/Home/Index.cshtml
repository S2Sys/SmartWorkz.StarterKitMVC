@model List<SmartWorkz.Sample.ECommerce.Application.DTOs.ProductDto>

@{ ViewData["Title"] = "Home"; }

<div class="jumbotron bg-light p-5 mb-4">
    <h1 class="display-4">Welcome to ShopWorkz</h1>
    <p class="lead">Discover amazing products at great prices</p>
    <button variant="success" size="lg" asp-controller="Catalog" asp-action="Products">
        <i class="bi bi-shop me-1"></i>Browse Catalog
    </button>
</div>

<h2 class="mb-4">Featured Products</h2>
<div class="row">
    @if (Model != null && Model.Count > 0)
    {
        @foreach (var product in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title">@product.Name</h5>
                            @if (product.Stock > 10)
                            {
                                <badge variant="success" size="sm">In Stock</badge>
                            }
                            else if (product.Stock > 0)
                            {
                                <badge variant="warning" size="sm">Low Stock</badge>
                            }
                            else
                            {
                                <badge variant="danger" size="sm">Out of Stock</badge>
                            }
                        </div>
                        <p class="card-text">@(product.Description != null && product.Description.Length > 50 ? product.Description.Substring(0, 50) + "..." : product.Description ?? "No description")</p>
                        <p class="card-text"><strong>$@product.Price</strong></p>
                    </div>
                    <div class="card-footer bg-white">
                        <a href="/product/@product.Id" class="btn btn-sm btn-primary">View Details</a>
                        <form method="post" action="/cart/add" style="display:inline">
                            <input type="hidden" name="productId" value="@product.Id" />
                            <button type="submit" class="btn btn-sm btn-success">Add to Cart</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <p class="text-muted">No products available at this time.</p>
        </div>
    }
</div>
