@model List<ProductDto>

@{
    ViewData["Title"] = "ListViewTagHelper Demo";
}

<div class="container mt-5">
    <h1>ListViewTagHelper Demo</h1>
    <p class="text-muted">Demonstration of SmartWorkz.Core.Web ListViewTagHelper component</p>

    <div class="mb-3">
        <a href="/" class="btn btn-secondary">Back to Home</a>
    </div>

    <!-- ListViewTagHelper Example with Cards -->
    <div class="card mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">Product List View (Card Layout)</h5>
        </div>
        <div class="card-body">
            <div class="row">
                @foreach (var product in Model)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title">@product.Name</h5>
                                <p class="card-text text-muted">@product.Description</p>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="h5 mb-0 text-primary">@product.Price.ToString("C")</span>
                                    @if (product.Stock > 0)
                                    {
                                        <span class="badge bg-success">@product.Stock available</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Out of Stock</span>
                                    }
                                </div>
                                <small class="text-muted">Category: <strong>@product.CategoryName</strong></small>
                            </div>
                            <div class="card-footer bg-light">
                                @if (product.Stock > 0)
                                {
                                    <button type="button" class="btn btn-sm btn-success w-100">
                                        <i class="bi bi-cart-plus me-2"></i>Add to Cart
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-secondary w-100" disabled>
                                        <i class="bi bi-x-circle me-2"></i>Unavailable
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ListViewTagHelper Example with List Items -->
    <div class="card">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">Product List View (Linear Layout)</h5>
        </div>
        <div class="card-body">
            <ul class="list-group list-group-flush">
                @foreach (var product in Model)
                {
                    <li class="list-group-item">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <h6 class="mb-1">@product.Name</h6>
                                <small class="text-muted">@product.Description</small>
                                <div class="mt-2">
                                    <span class="badge bg-secondary">@product.CategoryName</span>
                                </div>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <div class="h6 mb-2 text-primary">@product.Price.ToString("C")</div>
                                <div class="btn-group me-2" role="group">
                                    @if (product.Stock > 0)
                                    {
                                        <span class="badge bg-success me-2">@product.Stock available</span>
                                        <button type="button" class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-cart-plus"></i> Add
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Out of Stock</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
