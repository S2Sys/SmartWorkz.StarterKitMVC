@model List<ProductDto>

@{
    ViewData["Title"] = "GridTagHelper Demo";
}

<div class="container mt-5">
    <h1>GridTagHelper Demo</h1>
    <p class="text-muted">Demonstration of SmartWorkz.Core.Web GridTagHelper component</p>

    <div class="mb-3">
        <a href="/" class="btn btn-secondary">Back to Home</a>
    </div>

    <!-- GridTagHelper Example -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Product Grid with Sorting & Filtering</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Product Name</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Description</th>
                            <th>Category</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>@product.Id</td>
                                <td><strong>@product.Name</strong></td>
                                <td>@product.Price.ToString("C")</td>
                                <td>
                                    @if (product.Stock > 0)
                                    {
                                        <span class="badge bg-success">@product.Stock in stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Out of Stock</span>
                                    }
                                </td>
                                <td>@product.Description</td>
                                <td><span class="badge bg-info text-dark">@product.CategoryName</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Alternative: Card-based Grid -->
    <div class="card">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">Product Grid (Card Layout)</h5>
        </div>
        <div class="card-body">
            <div class="row">
                @foreach (var product in Model)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title">@product.Name</h5>
                                <p class="card-text text-muted small">@product.Description</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="h5 mb-0 text-primary">@product.Price.ToString("C")</span>
                                    @if (product.Stock > 0)
                                    {
                                        <span class="badge bg-success">@product.Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Out of Stock</span>
                                    }
                                </div>
                            </div>
                            <div class="card-footer bg-light">
                                @if (product.Stock > 0)
                                {
                                    <button type="button" class="btn btn-sm btn-primary w-100">Add to Cart</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-secondary w-100" disabled>Unavailable</button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
