<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShopWorkz</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-lg">
            <a class="navbar-brand" href="/">ShopWorkz</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/catalog">Catalog</a></li>
                    <li class="nav-item"><a class="nav-link" href="/cart">
                        Cart <span class="badge bg-warning">@(TempData["CartCount"] ?? 0)</span>
                    </a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="demoDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-puzzle me-1"></i>Demos
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="demoDropdown">
                            <li><a class="dropdown-item" href="/demo/griddemo">Grid Demo</a></li>
                            <li><a class="dropdown-item" href="/demo/listviewdemo">ListView Demo</a></li>
                        </ul>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="nav-link" href="/order/history">Orders</a></li>
                        <li class="nav-item">
                            <form method="post" action="/account/logout" style="display:inline">
                                <button class="nav-link btn btn-link" type="submit">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="/account/register">Register</a></li>
                        <li class="nav-item"><a class="nav-link" href="/account/login">Login</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-4">
        <div class="container-lg">
            @RenderBody()
        </div>
    </main>

    <footer class="bg-light text-center py-4 mt-5">
        <p>&copy; 2026 ShopWorkz - E-commerce Demo</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @if (TempData["ToastMessage"] != null)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:9999">
            <div id="liveToast" class="toast show align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-check-circle me-2"></i>@TempData["ToastMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
        <script>
            setTimeout(function() {
                var el = document.getElementById('liveToast');
                if (el) { var toast = new bootstrap.Toast(el, {delay:3000}); toast.show(); }
            }, 100);
        </script>
    }
</body>
</html>
