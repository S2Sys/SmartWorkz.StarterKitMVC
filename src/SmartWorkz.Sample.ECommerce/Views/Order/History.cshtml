@model List<SmartWorkz.Sample.ECommerce.Application.DTOs.OrderDto>

@{ ViewData["Title"] = "Order History"; }

@{
    var breadcrumbs = new List<SmartWorkz.Web.BreadcrumbItem>
    {
        new() { Label = "Home", Url = "/" },
        new() { Label = "My Orders", Url = null }
    };
}
<breadcrumb items="breadcrumbs"></breadcrumb>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>My Orders</h2>
    <div>
        <a href="/Order/ExportExcel" class="btn btn-success btn-sm me-1">
            <i class="bi bi-file-earmark-excel me-1"></i>Export Excel
        </a>
        <a href="/Order/ExportPdf" class="btn btn-danger btn-sm me-1">
            <i class="bi bi-file-earmark-pdf me-1"></i>Export PDF
        </a>
        <a href="/Order/ExportCsv" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-filetype-csv me-1"></i>Export CSV
        </a>
    </div>
</div>

@if (Model != null && Model.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Order ID</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    var statusVariant = order.Status switch {
                        "Delivered" => "success",
                        "Shipped" => "info",
                        "Processing" => "warning",
                        "Cancelled" => "danger",
                        _ => "secondary"
                    };
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.PlacedAt.ToString("MMM dd, yyyy")</td>
                        <td>$@order.Total</td>
                        <td>
                            <badge variant="@statusVariant">@order.Status</badge>
                        </td>
                        <td>
                            <a href="/order/detail/@order.Id" class="btn btn-sm btn-primary">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <p>No orders found.</p>
        <a href="/catalog" class="btn btn-primary">Start Shopping</a>
    </div>
}
