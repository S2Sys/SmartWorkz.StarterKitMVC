@namespace SmartWorkz.Core.Web.Components.FormBuilder
@using System
@using System.Globalization

<div class="form-group mb-3 @(CssClass ?? "")">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="rich-editor-@UniqueId" class="form-label">
            @Label
            @if (IsRequired)
            {
                <span class="text-danger" title="Required">*</span>
            }
        </label>
    }

    @* Toolbar with formatting buttons *@
    @if (!IsDisabled)
    {
        <div class="btn-toolbar mb-2" role="toolbar" aria-label="Editor formatting toolbar">
            <div class="btn-group btn-group-sm me-2" role="group" aria-label="Text formatting">
                <button type="button"
                        class="btn btn-outline-secondary"
                        title="Bold (Ctrl+B)"
                        @onclick="ApplyBold"
                        disabled="@IsDisabled">
                    <strong>B</strong>
                </button>
                <button type="button"
                        class="btn btn-outline-secondary"
                        title="Italic (Ctrl+I)"
                        @onclick="ApplyItalic"
                        disabled="@IsDisabled">
                    <em>I</em>
                </button>
                <button type="button"
                        class="btn btn-outline-secondary"
                        title="Underline (Ctrl+U)"
                        @onclick="ApplyUnderline"
                        disabled="@IsDisabled">
                    <u>U</u>
                </button>
                <button type="button"
                        class="btn btn-outline-secondary"
                        title="Strikethrough"
                        @onclick="ApplyStrikethrough"
                        disabled="@IsDisabled">
                    <s>S</s>
                </button>
            </div>

            <div class="btn-group btn-group-sm me-2" role="group" aria-label="Link and code formatting">
                <button type="button"
                        class="btn btn-outline-secondary"
                        title="Insert Link"
                        @onclick="ShowLinkDialog"
                        disabled="@IsDisabled">
                    &#128279;
                </button>
                <button type="button"
                        class="btn btn-outline-secondary"
                        title="Inline Code"
                        @onclick="ApplyCode"
                        disabled="@IsDisabled">
                    &lt;code&gt;
                </button>
            </div>

            <div class="btn-group btn-group-sm" role="group" aria-label="Undo and redo">
                <button type="button"
                        class="btn btn-outline-secondary"
                        title="Undo"
                        @onclick="Undo"
                        disabled="@(IsDisabled || UndoStack.Count == 0)">
                    &#8617;
                </button>
                <button type="button"
                        class="btn btn-outline-secondary"
                        title="Redo"
                        @onclick="Redo"
                        disabled="@(IsDisabled || RedoStack.Count == 0)">
                    &#8618;
                </button>
            </div>
        </div>
    }

    @* Rich text editor area *@
    <div id="rich-editor-@UniqueId"
         class="form-control rich-text-editor @ErrorClass"
         style="height: @Height; overflow-y: auto; white-space: pre-wrap; word-wrap: break-word; padding: 10px; resize: vertical;"
         contenteditable="@(!IsDisabled)"
         role="textbox"
         aria-label="@(Label ?? "Rich text editor")"
         @ondblclick="OnEditorClick"
         @onblur="OnEditorBlur"
         @onkeydown="OnEditorKeyDown"
         @onpaste="OnPaste"
         @suppress-content-edit-warning>
        @((MarkupString)InitialContent)
    </div>

    @* Link dialog modal *@
    @if (ShowLinkModal)
    {
        <div class="modal d-block" style="background-color: rgba(0,0,0,0.5); display: block;">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Insert Link</h5>
                        <button type="button" class="btn-close" @onclick="CloseLinkDialog"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="link-text-@UniqueId" class="form-label">Link Text</label>
                            <input type="text"
                                   id="link-text-@UniqueId"
                                   class="form-control"
                                   placeholder="Enter text to display"
                                   @bind="LinkText" />
                        </div>
                        <div class="mb-3">
                            <label for="link-url-@UniqueId" class="form-label">URL</label>
                            <input type="url"
                                   id="link-url-@UniqueId"
                                   class="form-control"
                                   placeholder="https://example.com"
                                   @bind="LinkUrl" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseLinkDialog">Cancel</button>
                        <button type="button" class="btn btn-primary" @onclick="InsertLink">Insert</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Placeholder text *@
    @if (string.IsNullOrEmpty(CurrentContent) && !string.IsNullOrEmpty(Placeholder))
    {
        <small class="form-text text-muted d-block mt-1" style="position: absolute; pointer-events: none;">
            @Placeholder
        </small>
    }

    @* Error message *@
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="invalid-feedback d-block mt-1">
            @ErrorMessage
        </div>
    }

    @* Help text *@
    @if (!string.IsNullOrEmpty(HelpText))
    {
        <small class="form-text text-muted d-block mt-1">
            @HelpText
        </small>
    }
</div>

@code {
    /// <summary>
    /// Gets or sets the HTML content of the editor.
    /// </summary>
    [Parameter]
    public string? Content { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the content changes.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnContentChanged { get; set; }

    /// <summary>
    /// Gets or sets the optional label text displayed above the editor.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Gets or sets the optional error message displayed below the editor.
    /// </summary>
    [Parameter]
    public string? ErrorMessage { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether the editor is disabled.
    /// </summary>
    [Parameter]
    public bool IsDisabled { get; set; }

    /// <summary>
    /// Gets or sets the placeholder text displayed when the editor is empty.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Gets or sets the height of the editor (default: "300px").
    /// </summary>
    [Parameter]
    public string Height { get; set; } = "300px";

    /// <summary>
    /// Gets or sets the optional CSS class applied to the container.
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets the optional help text displayed below the editor.
    /// </summary>
    [Parameter]
    public string? HelpText { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether the editor is required.
    /// </summary>
    [Parameter]
    public bool IsRequired { get; set; }

    private string UniqueId { get; set; } = Guid.NewGuid().ToString("N").Substring(0, 8);
    private string CurrentContent { get; set; } = string.Empty;
    private string InitialContent { get; set; } = string.Empty;
    private Stack<string> UndoStack { get; set; } = new();
    private Stack<string> RedoStack { get; set; } = new();
    private bool ShowLinkModal { get; set; }
    private string LinkText { get; set; } = string.Empty;
    private string LinkUrl { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        InitialContent = Content ?? string.Empty;
        CurrentContent = Content ?? string.Empty;
        if (!string.IsNullOrEmpty(CurrentContent))
        {
            UndoStack.Push(CurrentContent);
        }
    }

    /// <summary>
    /// Gets the CSS class for error state styling.
    /// </summary>
    private string ErrorClass =>
        !string.IsNullOrEmpty(ErrorMessage) ? "is-invalid border-danger" : string.Empty;

    /// <summary>
    /// Applies bold formatting to selected text.
    /// </summary>
    private async Task ApplyBold()
    {
        await ExecuteCommand("bold", null);
    }

    /// <summary>
    /// Applies italic formatting to selected text.
    /// </summary>
    private async Task ApplyItalic()
    {
        await ExecuteCommand("italic", null);
    }

    /// <summary>
    /// Applies underline formatting to selected text.
    /// </summary>
    private async Task ApplyUnderline()
    {
        await ExecuteCommand("underline", null);
    }

    /// <summary>
    /// Applies strikethrough formatting to selected text.
    /// </summary>
    private async Task ApplyStrikethrough()
    {
        await ExecuteCommand("strikethrough", null);
    }

    /// <summary>
    /// Applies code formatting to selected text.
    /// </summary>
    private async Task ApplyCode()
    {
        // For code, we'll wrap in a code tag using formatBlock or insertHTML
        await ExecuteCommand("formatBlock", "code");
    }

    /// <summary>
    /// Shows the link insertion dialog.
    /// </summary>
    private async Task ShowLinkDialog()
    {
        ShowLinkModal = true;
        await Task.Yield();
    }

    /// <summary>
    /// Closes the link insertion dialog.
    /// </summary>
    private async Task CloseLinkDialog()
    {
        ShowLinkModal = false;
        LinkText = string.Empty;
        LinkUrl = string.Empty;
        await Task.Yield();
    }

    /// <summary>
    /// Inserts a link with the specified URL and text.
    /// </summary>
    private async Task InsertLink()
    {
        if (!string.IsNullOrEmpty(LinkUrl) && !string.IsNullOrEmpty(LinkText))
        {
            await ExecuteCommand("createLink", LinkUrl);
            await CloseLinkDialog();
        }
    }

    /// <summary>
    /// Undoes the last content change.
    /// </summary>
    private async Task Undo()
    {
        if (UndoStack.Count > 1)
        {
            RedoStack.Push(UndoStack.Pop());
            var previousContent = UndoStack.Peek();
            CurrentContent = previousContent;
            InitialContent = previousContent;
            await NotifyContentChanged();
        }
    }

    /// <summary>
    /// Redoes the last undone change.
    /// </summary>
    private async Task Redo()
    {
        if (RedoStack.Count > 0)
        {
            var nextContent = RedoStack.Pop();
            UndoStack.Push(nextContent);
            CurrentContent = nextContent;
            InitialContent = nextContent;
            await NotifyContentChanged();
        }
    }

    /// <summary>
    /// Executes a rich text command.
    /// </summary>
    private async Task ExecuteCommand(string command, string? value)
    {
        // Save current state to undo stack
        RedoStack.Clear();
        UndoStack.Push(CurrentContent);

        // Command execution would be handled in JavaScript in real implementation
        // For now, we simulate it in the blur handler
        await Task.Yield();
    }

    /// <summary>
    /// Handles editor click events.
    /// </summary>
    private async Task OnEditorClick()
    {
        await Task.Yield();
    }

    /// <summary>
    /// Handles editor blur events and updates content.
    /// </summary>
    private async Task OnEditorBlur()
    {
        // Content would be captured from the contenteditable div
        await NotifyContentChanged();
    }

    /// <summary>
    /// Handles keyboard shortcuts like Ctrl+B, Ctrl+I, etc.
    /// </summary>
    private async Task OnEditorKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.MetaKey)
        {
            switch (e.Key.ToLower())
            {
                case "b":
                    await ApplyBold();
                    break;
                case "i":
                    await ApplyItalic();
                    break;
                case "u":
                    await ApplyUnderline();
                    break;
                case "z":
                    if (!e.ShiftKey)
                    {
                        await Undo();
                    }
                    else
                    {
                        await Redo();
                    }
                    break;
            }
        }
    }

    /// <summary>
    /// Handles paste events to ensure proper content handling.
    /// </summary>
    private async Task OnPaste()
    {
        // Allow paste to execute naturally
        await Task.Yield();
    }

    /// <summary>
    /// Notifies listeners of content changes.
    /// </summary>
    private async Task NotifyContentChanged()
    {
        if (OnContentChanged.HasDelegate)
        {
            await OnContentChanged.InvokeAsync(CurrentContent);
        }
    }
}
